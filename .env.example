# Локальный запуск. На Bothost добавьте эти значения в «Переменные окружения».
DISCORD_BOT_TOKEN=вставьте_токен_сюда

# Необязательно: команды появятся на тестовом сервере почти сразу.
# Перед публикацией можно убрать эту переменную для глобальной синхронизации.
SYNC_GUILD_ID=

# Локально можно оставить пустым. На Bothost используйте /app/data/clan_bot.db.
DATABASE_PATH=

